# ---------------------------------------------------------------------------
# MBU Backend - environment template
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# Which settings module to load: development | production
DJANGO_ENV=development

# Cryptographic signing key. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database. Leave DATABASE_URL unset to fall back to local SQLite.
#   Postgres: postgres://user:password@host:5432/dbname
#   MySQL:    mysql://user:password@host:3306/dbname
# URL-encode any @ : / ? # characters in the password.
# DATABASE_URL=mysql://user:password@host:3306/dbname

# MySQL only. TLS is REQUIRED by default (encrypt, do not verify the server
# certificate). Set DATABASE_SSL_CA and raise this to VERIFY_CA to authenticate
# the server too; DISABLED turns TLS off entirely.
# DATABASE_SSL_MODE=REQUIRED
# DATABASE_SSL_CA=/path/to/ca.pem
# DATABASE_CONN_MAX_AGE=60

# Frontend origins allowed to call the API (comma separated).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ALL_ORIGINS=False

# Absolute base URL of this site, used to build canonical/OG URLs for SEO.
SITE_BASE_URL=http://localhost:8000
SITE_NAME=Mohan Babu University

# Media / static roots (relative to the project root unless absolute)
MEDIA_ROOT=media
STATIC_ROOT=staticfiles

# ---------------------------------------------------------------------------
# Media storage on Amazon S3
# ---------------------------------------------------------------------------
# Leave USE_S3=False to keep uploads on the local disk (recommended for local
# development). Set it to True and fill in the four values below to store every
# uploaded image in the bucket instead. See docs/deployment.md for the bucket
# policy and the IAM policy these credentials need.
USE_S3=False
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: CloudFront / CNAME that serves the bucket. Leave empty to use the
# default `<bucket>.s3.<region>.amazonaws.com` endpoint.
AWS_S3_CUSTOM_DOMAIN=

# Optional: only for S3-compatible providers (Cloudflare R2, DigitalOcean
# Spaces, MinIO). Leave empty for real AWS S3.
AWS_S3_ENDPOINT_URL=

# Time zone / language
DJANGO_TIME_ZONE=Asia/Kolkata
DJANGO_LANGUAGE_CODE=en-us

# ---------------------------------------------------------------------------
# MCP server (Claude access)
# ---------------------------------------------------------------------------
# Base URL of the running Django backend the MCP server writes to.
MBU_API_BASE_URL=http://127.0.0.1:8000
# DRF auth token used by the MCP server. Create one with:
#   python manage.py create_api_token --username <user>
MBU_API_TOKEN=
# Request timeout (seconds) for MCP -> API calls
MBU_API_TIMEOUT=60
