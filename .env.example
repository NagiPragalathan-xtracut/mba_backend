# ---------------------------------------------------------------------------
# MBU Backend - environment template
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# Which settings module to load: development | production
DJANGO_ENV=development

# Cryptographic signing key. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database. Leave DATABASE_URL unset to fall back to local SQLite.
# Postgres example: postgres://user:password@localhost:5432/mbu
# DATABASE_URL=postgres://mbu:mbu@localhost:5432/mbu

# Frontend origins allowed to call the API (comma separated).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ALL_ORIGINS=False

# Absolute base URL of this site, used to build canonical/OG URLs for SEO.
SITE_BASE_URL=http://localhost:8000
SITE_NAME=Mohan Babu University

# Media / static roots (relative to the project root unless absolute)
MEDIA_ROOT=media
STATIC_ROOT=staticfiles

# Time zone / language
DJANGO_TIME_ZONE=Asia/Kolkata
DJANGO_LANGUAGE_CODE=en-us

# ---------------------------------------------------------------------------
# MCP server (Claude access)
# ---------------------------------------------------------------------------
# Base URL of the running Django backend the MCP server writes to.
MBU_API_BASE_URL=http://127.0.0.1:8000
# DRF auth token used by the MCP server. Create one with:
#   python manage.py create_api_token --username <user>
MBU_API_TOKEN=
# Request timeout (seconds) for MCP -> API calls
MBU_API_TIMEOUT=60
